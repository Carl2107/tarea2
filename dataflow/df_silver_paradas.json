{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "paradas"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> paradas",
				"paradas derive(ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          CodigoPublicado = ParadaHistoricaId,",
				"          NombreParada = trim(NombreParada),",
				"          Zona = trim(Zona),",
				"          Latitud = toDecimal(Latitud, 9, 4),",
				"          Longitud = toDecimal(Longitud, 9, 4),",
				"          VigenciaDesde = iif(instr(VigenciaDesde, '/') > 0, toDate(VigenciaDesde, 'dd/MM/yyyy'), toDate(VigenciaDesde, 'yyyy-MM-dd')),",
				"          VigenciaHasta = iif(instr(VigenciaHasta, '/') > 0, toDate(VigenciaHasta, 'dd/MM/yyyy'), toDate(VigenciaHasta, 'yyyy-MM-dd')),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(ParadaHistoricaId),",
				"     CodigoPublicado = first(CodigoPublicado),",
				"          NombreParada = first(NombreParada),",
				"          Zona = first(Zona),",
				"          Latitud = first(Latitud),",
				"          Longitud = first(Longitud),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}